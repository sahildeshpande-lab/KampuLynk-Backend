
DATABASE_URL=postgresql://postgres:root@localhost:5432/ksolves
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com


JWT_SECRET=change-this-to-a-secure-random-value-at-least-32-bytes
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=1440


DEFAULT_DAYS=7
MAX_DAYS=90
DEFAULT_TOP_LIMIT=5
MAX_TOP_LIMIT=20


DEFAULT_COMMENT_MAX_DEPTH=3

INVITATION_DAILY_LIMIT=50
INVITATION_TIMEZONE=Asia/Calcutta
INVITATION_BLOCK_EMAIL_DAYS=7
INVITATION_CODE_LENGTH=10 

INVITATION_DEEP_LINK_BASE=
INVITATION_WEB_URL_BASE=
