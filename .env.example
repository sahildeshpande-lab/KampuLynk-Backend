# Db
DATABASE_URL=postgresql://postgres:root@localhost:5432/ksolves

# Sendgrid
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com


# firebase
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-adminsdk.json


# JWT
JWT_SECRET=change-this-to-a-secure-random-value-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Analytics
DEFAULT_DAYS=7
MAX_DAYS=90
DEFAULT_TOP_LIMIT=5
MAX_TOP_LIMIT=20

# Post comments
DEFAULT_COMMENT_MAX_DEPTH=3

# Invitations
INVITATION_DAILY_LIMIT=50
INVITATION_TIMEZONE=Asia/Calcutta
INVITATION_BLOCK_EMAIL_DAYS=7
INVITATION_CODE_LENGTH=10 
INVITATION_DEEP_LINK_BASE=
INVITATION_WEB_URL_BASE=

# AWS S3 Configuration for Image Storage
AWS_REGION=us-east-1

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID

AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

AWS_S3_BUCKET_NAME=YOUR_S3_BUCKET_NAME

AWS_S3_BASE_URL=YOUR_CDN_BASE_URL
APP_ENV=local
